# Copy to .env.local for local use, or enter these in Netlify (Site configuration -> Environment variables).
# Never commit real values.

# Hosted Postgres (e.g. Supabase "Transaction pooler" string). Leave unset locally to use the embedded database.
# Required in production: without it the app refuses to start (ALLOW_EMBEDDED_DB=true overrides, single-process only).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# First admin, created on first start if this email doesn't exist yet. Password: 12+ characters.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Production only: set to true to also create the well-known demo accounts (throwaway demos only).
# SEED_DEMO_USERS=false

# Set automatically by netlify.toml on Netlify; true makes the UI poll instead of using server-sent events.
# DISABLE_SSE=true

# Push notifications (Web Push). Generate once with:  npx web-push generate-vapid-keys
# Without these, alerts are simply off. Keep the private key secret; the public key is served to browsers.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
